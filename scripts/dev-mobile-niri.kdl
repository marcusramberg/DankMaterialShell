// Niri config for the nested mobile dev session (see scripts/dev-mobile.sh).
// Kept minimal on purpose: this compositor exists to host DMS in a phone-sized
// window, not to be a usable desktop. The shell itself is passed to niri as a
// startup command by the script, so this file stays path-independent.

environment {
    DMS_MOBILE "1"
    // The nested shell must not drive the outer session's dms daemon.
    DMS_SOCKET null
}

// The winit backend exposes a single output named "winit". A 720x1440 mode at
// scale 2 gives 360x720 logical pixels, the narrowest layout the mobile work
// targets.
output "winit" {
    mode "720x1440"
    scale 2
}

layout {
    gaps 0
    border {
        off
    }
    focus-ring {
        off
    }
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Return { spawn "foot"; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit skip-confirmation=true; }
}
