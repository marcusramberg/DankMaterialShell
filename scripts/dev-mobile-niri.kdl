// Nested mobile dev session, see scripts/dev-mobile.sh. The script passes the
// shell in as a startup command, so this stays path-independent.

environment {
    DMS_MOBILE "1"
    // Must not drive the outer session's dms daemon.
    DMS_SOCKET null
}

// 720x1440 at scale 2 is 360x720 logical, the narrowest layout targeted.
output "winit" {
    mode "720x1440"
    scale 2
}

layout {
    gaps 0
    border {
        off
    }
    focus-ring {
        off
    }
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Return { spawn "foot"; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit skip-confirmation=true; }
}
